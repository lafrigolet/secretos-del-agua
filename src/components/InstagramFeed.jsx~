import React, { useEffect, useState, useRef } from "react";
import Masonry from "@mui/lab/Masonry";
import { Card, CardMedia, CardContent, Typography, Avatar } from "@mui/material";

const RAPIDAPI_HOST = "instagram120.p.rapidapi.com";
const RAPIDAPI_KEY = "YOUR_RAPIDAPI_KEY_HERE"; // Replace with your key

const InstagramFeed = ({ username = "nasa" }) => {
  const [posts, setPosts] = useState([]);
  const [activeIndex, setActiveIndex] = useState(0);
  const videoRefs = useRef([]);

  // Fetch public Instagram posts
  const fetchPosts = async () => {
    try {
      const response = await fetch(`https://${RAPIDAPI_HOST}/api/instagram/posts`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-rapidapi-host": RAPIDAPI_HOST,
          "x-rapidapi-key": RAPIDAPI_KEY,
        },
        body: JSON.stringify({ username, maxId: "" }),
      });

      const res = await response.json();
      const edges = res?.result?.edges || [];

      // Simplify structure
      const formattedPosts = edges.map(({ node }) => ({
        id: node.id,
        username: node.user?.username,
        profilePic: node.user?.profile_pic_url,
        caption: node.caption?.text,
        mediaType: node.media_type,
        video: node.video_versions?.[0]?.url || null,
        image:
          node.image_versions2?.candidates?.[0]?.url ||
          node.carousel_media?.[0]?.image_versions2?.candidates?.[0]?.url,
      }));

      setPosts(formattedPosts.filter((p) => p.image || p.video));
    } catch (error) {
      console.error("Fetch failed:", error);
    }
  };

  // Play only one video at a time
  useEffect(() => {
    videoRefs.current.forEach((video, idx) => {
      if (video) {
        if (idx === activeIndex) {
          video.play().catch(() => {});
        } else {
          video.pause();
          video.currentTime = 0;
        }
      }
    });
  }, [activeIndex, posts]);

  // Automatically advance after video ends
  const handleVideoEnd = () => {
    setActiveIndex((prev) => (prev + 1) % posts.length);
  };

  useEffect(() => {
    fetchPosts();
  }, [username]);

  return (
    <div className="p-4 bg-gray-100 min-h-screen">
      <Typography variant="h5" className="font-bold mb-4 text-center">
        @{username} Instagram Feed
      </Typography>

      <Masonry columns={{ xs: 1, sm: 2, md: 3 }} spacing={2}>
        {posts.map((post, index) => (
          <Card
            key={post.id}
            className="rounded-2xl shadow-md hover:shadow-lg transition-all bg-white"
          >
            {post.video ? (
              <video
                ref={(el) => (videoRefs.current[index] = el)}
                src={post.video}
                controls
                className="w-full rounded-t-2xl"
                onEnded={handleVideoEnd}
              />
            ) : (
              <CardMedia
                component="img"
                image={post.image}
                alt={post.caption}
                className="rounded-t-2xl"
              />
            )}

            <CardContent>
              <div className="flex items-center mb-2">
                <Avatar src={post.profilePic} alt={post.username} className="mr-2" />
                <Typography variant="subtitle1" className="font-semibold">
                  @{post.username}
                </Typography>
              </div>
              <Typography variant="body2" color="text.secondary">
                {post.caption?.slice(0, 150) || ""}
              </Typography>
            </CardContent>
          </Card>
        ))}
      </Masonry>
    </div>
  );
};

export default InstagramFeed;
